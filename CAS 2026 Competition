
# CAS Predictive Modeling: Full Pipeline with Premium Calculation

import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestRegressor
from xgboost import XGBRegressor, XGBClassifier
from sklearn.metrics import mean_squared_error, r2_score, roc_auc_score
import statsmodels.api as sm


data = pd.read_excel("/Users/thinurishehara/Downloads/06 - CAS Predictive Modeling Case Competition- Dataset-2.xlsx")

# Preprocessing

data['sprinklered'] = data['sprinklered'].astype(int)
data['claim_occurred'] = (data['amount'] > 0).astype(int)
data = data.rename(columns={'class': 'student_class'})  # avoid Python keyword issues

# Map categorical variables to numeric
class_mapping = {'Freshman': 1, 'Sophomore': 2, 'Junior': 3, 'Senior': 4, 'Grad student':5}
data['student_class_num'] = data['student_class'].map(class_mapping)
data['greek_bin'] = data['greek'].map({'Non-greek': 0, 'Greek': 1})
data['off_campus_bin'] = data['off_campus'].map({'On campus': 0, 'Off campus': 1})

# Split data
train_data = data[data['holdout'] == False].copy()
holdout_data = data[data['holdout'] == True].copy()

# Aggregate to student-level
student_train = train_data.groupby('student_id').agg(
    risk_tier=('risk_tier', 'first'),
    student_class_num=('student_class_num', 'first'),
    greek_bin=('greek_bin', 'first'),
    off_campus_bin=('off_campus_bin', 'first'),
    sprinklered=('sprinklered', 'first'),
    gpa=('gpa', 'first'),
    distance_to_campus=('distance_to_campus', 'first'),
    claim_occurred=('claim_occurred', 'max'),
    total_claim_amount=('amount', 'sum')
).reset_index()

severity_data = student_train[student_train['total_claim_amount'] > 0]


# Features
freq_features = ['risk_tier', 'student_class_num', 'greek_bin', 'off_campus_bin', 'sprinklered', 'gpa', 'distance_to_campus']
X_train = student_train[freq_features].apply(pd.to_numeric)
y_freq = student_train['claim_occurred'].astype(int)

# Frequency Model (XGBoost)
xgb_freq = XGBClassifier(eval_metric='logloss', random_state=42)
xgb_freq.fit(X_train, y_freq)
student_train['pred_claim_prob_xgb'] = xgb_freq.predict_proba(X_train)[:, 1]
print("Frequency model AUC (train):", roc_auc_score(y_freq, student_train['pred_claim_prob_xgb']))

# Frequency Model (Logit)
X_train_logit = sm.add_constant(X_train, has_constant='add')  # Add intercept
logit_model = sm.Logit(y_freq, X_train_logit).fit()
print(logit_model.summary())

# Severity Model (XGBoost)
sev_X = X_train.loc[severity_data.index]
sev_y = severity_data['total_claim_amount']

xgb_sev = XGBRegressor(random_state=42)
xgb_sev.fit(sev_X, sev_y)
student_train['pred_claim_amount_xgb'] = xgb_sev.predict(X_train)
student_train['pred_claim_amount_xgb'] = np.clip(student_train['pred_claim_amount_xgb'], 0, None)

# Expected loss
student_train['expected_loss_xgb'] = student_train['pred_claim_prob_xgb'] * student_train['pred_claim_amount_xgb']

# Base Rates and Premiums
base_rates = {1: 100, 2: 150, 3: 200}
student_train['base_rate'] = student_train['risk_tier'].map(base_rates)

student_train['loss_multiplier'] = student_train.groupby('risk_tier')['expected_loss_xgb'].transform(
    lambda x: 1 + (x - x.min()) / (x.max() - x.min())
)
student_train['loss_multiplier'] = student_train['loss_multiplier'].clip(0.5, 3.0)
student_train['premium'] = student_train['base_rate'] * student_train['loss_multiplier']

# Random Forest as alternative (optional)
rf_model = RandomForestRegressor(n_estimators=200, random_state=42)
rf_model.fit(X_train, student_train['expected_loss_xgb'])
student_train['expected_loss_rf'] = rf_model.predict(X_train)

rmse_rf = np.sqrt(mean_squared_error(student_train['expected_loss_xgb'], student_train['expected_loss_rf']))
r2_rf = r2_score(student_train['expected_loss_xgb'], student_train['expected_loss_rf'])
print("Random Forest RMSE:", rmse_rf)
print("Random Forest R²:", r2_rf)

# Top Students by Premium
top_students = student_train.sort_values('premium', ascending=False)
print(top_students[['student_id', 'risk_tier', 'expected_loss_xgb', 'base_rate', 'loss_multiplier', 'premium']].head(10))

# Holdout Predictions
student_holdout = holdout_data.groupby('student_id').agg(
    risk_tier=('risk_tier', 'first'),
    student_class_num=('student_class_num', 'first'),
    greek_bin=('greek_bin', 'first'),
    off_campus_bin=('off_campus_bin', 'first'),
    sprinklered=('sprinklered', 'first'),
    gpa=('gpa', 'first'),
    distance_to_campus=('distance_to_campus', 'first')
).reset_index()

X_holdout = student_holdout[freq_features].apply(pd.to_numeric)
X_holdout = X_holdout.reindex(columns=X_train.columns, fill_value=0)

student_holdout['pred_claim_prob_xgb'] = xgb_freq.predict_proba(X_holdout)[:, 1]
student_holdout['pred_claim_amount_xgb'] = xgb_sev.predict(X_holdout)
student_holdout['pred_claim_amount_xgb'] = np.clip(student_holdout['pred_claim_amount_xgb'], 0, None)
student_holdout['expected_loss_xgb'] = student_holdout['pred_claim_prob_xgb'] * student_holdout['pred_claim_amount_xgb']

student_holdout['base_rate'] = student_holdout['risk_tier'].map(base_rates)
student_holdout['loss_multiplier'] = student_holdout.groupby('risk_tier')['expected_loss_xgb'].transform(
    lambda x: 1 + (x - x.min()) / (x.max() - x.min())
)
student_holdout['loss_multiplier'] = student_holdout['loss_multiplier'].clip(0.5, 3.0)
student_holdout['premium'] = student_holdout['base_rate'] * student_holdout['loss_multiplier']

print(student_holdout[['student_id', 'risk_tier', 'expected_loss_xgb', 'base_rate', 'loss_multiplier', 'premium']].head(10))


